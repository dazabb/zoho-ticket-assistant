{
  "manifest_version": 3,
  "name": "Ticket Assistant Zoho Autofill",
  "version": "1.0.1",
  "description": "Auto-fills the Zoho Desk new ticket form using data opened from Ticket Assistant.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["clipboardRead", "tabs", "storage"],
  "host_permissions": [
    "https://helpcenter.amti.com.ph/*",
    "https://*.zoho.com/*",
    "https://*.zoho.com.ph/*"
  ]
}
