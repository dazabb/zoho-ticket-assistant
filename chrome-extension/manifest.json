{
  "manifest_version": 3,
  "name": "MAU Operation Desk - Zoho Autofill",
  "version": "1.6.2",
  "description": "Fill new or confirmed edit tickets in SANDZ and Managed Shared Service; manual Save/Submit.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*",
        "https://dazabb.github.io/zoho-ticket-assistant/*",
        "file:///*",
        "https://helpcenter.amti.com.ph/*",
        "https://*.zoho.com/*",
        "https://*.zoho.com.ph/*"
      ],
      "js": [
        "zoho-dropdown-map.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://helpcenter.amti.com.ph/*",
    "https://*.zoho.com/*",
    "https://*.zoho.com.ph/*"
  ]
}
